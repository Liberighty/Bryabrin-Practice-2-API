@model List<GodSimulatorClient.Data.Division>

@{
    ViewData["Title"] = "Отделы разработки";
}
<div class="mb-3">
<h4>Отделы</h4>
    <a href="/Division/add"><button class="btn btn-primary">Новый отдел</button></a>
</div>

<div class="row">
<table class="table">
    <tr>
        <th>Список отделов компании</th>
        <th>Действия</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>
                    <a href="/Division/RemoveDivision/@item.Id">Уволить отдел</a>
            </td>
        </tr>
    }
        <p>ВНИМАНИЕ! Главы наших отделов не обременяют себя так называемой "этикой", поэтому при увольнении отдела они откатывают все изменения назад.</p>
</table>
</div>